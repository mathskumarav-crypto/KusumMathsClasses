<script>
document.addEventListener("DOMContentLoaded", function () {
  if (typeof renderMathInElement === "function") {
    renderMathInElement(document.body, {delimiters:[{left:"$$",right:"$$",display:true},{left:"$",right:"$",display:false}]});
  }
  document.querySelectorAll(".card").forEach(function(card) {
    const correct = card.getAttribute("data-correct");
    const options = card.querySelectorAll(".option");
    const answer = card.querySelector(".answer-section");
    const view = card.querySelector(".view-answer-btn");
    if (view && answer) view.addEventListener("click", function() {
      answer.classList.toggle("show");
      view.innerHTML = answer.classList.contains("show")
        ? '<i class="fa-regular fa-eye-slash"></i> Hide Answer'
        : '<i class="fa-regular fa-eye"></i> View Answer';
    });
    options.forEach(function(option) {
      option.addEventListener("click", function() {
        if (card.classList.contains("answered")) return;
        card.classList.add("answered");
        const selected = this.getAttribute("data-option");
        options.forEach(function(item) {
          item.style.pointerEvents = "none";
          if (item.getAttribute("data-option") === correct) item.classList.add("correct");
        });
        if (selected !== correct) this.classList.add("incorrect");
        if (answer) answer.classList.add("show");
        if (view) view.innerHTML = '<i class="fa-regular fa-eye-slash"></i> Hide Answer';
      });
    });
  });
  const toggle = document.getElementById("menu-toggle");
  const nav = document.getElementById("nav-links");
  if (toggle && nav) toggle.addEventListener("click", function() {
    const open = nav.classList.toggle("active");
    toggle.setAttribute("aria-expanded", String(open));
    toggle.innerHTML = open ? '<i class="fa-solid fa-xmark"></i>' : '<i class="fa-solid fa-bars"></i>';
  });
});
function shareQuestion(button) {
  const card = button.closest(".card");
  const heading = card && card.querySelector(".question_heading");
  const title = heading ? heading.textContent + " | Kusum Maths Classes" : document.title;
  if (navigator.share) {
    navigator.share({title:title,url:window.location.href}).catch(function(){});
  } else if (navigator.clipboard) {
    navigator.clipboard.writeText(window.location.href).then(function(){alert("Link copied to clipboard!");})
    .catch(function(){prompt("Copy this page link:",window.location.href);});
  } else prompt("Copy this page link:",window.location.href);
}
</script>
